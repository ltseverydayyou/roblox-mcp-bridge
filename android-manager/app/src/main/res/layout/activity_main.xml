<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:paddingLeft="16dp" android:paddingTop="22dp"
        android:paddingRight="16dp" android:paddingBottom="32dp">

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="ROBLOX MCP MANAGER" android:textColor="@color/accent" android:textSize="12sp" android:textStyle="bold" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp"
            android:text="Self-contained Android bridge" android:textColor="@color/text" android:textSize="27sp" android:textStyle="bold" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:layout_marginBottom="18dp"
            android:text="Embedded Node.js, bridge controls, health checks, and console logs. Termux, Git, and a separate Node install are not required."
            android:textColor="@color/muted" android:textSize="14sp" />

        <LinearLayout style="@style/Card" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
            <TextView style="@style/SectionTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Embedded runtime" />
            <TextView style="@style/HintText" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="The first preparation extracts the bundled ARM64 Node runtime and MCP server. Future MCP source revisions download separately as verified runtime bundles, so the APK does not need to be reinstalled for ordinary bridge updates." />
            <TextView android:id="@+id/runtimeStatus" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginBottom="8dp" android:text="EMBEDDED NODE: CHECKING" android:textColor="@color/warning" android:textStyle="bold" />
            <TextView android:id="@+id/runtimeSourceStatus" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginBottom="8dp" android:text="MCP SOURCE: CHECKING" android:textColor="@color/muted" android:textSize="12sp" android:textStyle="bold" />
            <Button android:id="@+id/prepareRuntimeButton" style="@style/ManagerButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Prepare embedded runtime" />
            <Button android:id="@+id/runtimeUpdateButton" style="@style/ManagerButton.Secondary" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Check MCP source update" />
        </LinearLayout>

        <LinearLayout style="@style/Card" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
            <TextView style="@style/SectionTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="System health" />
            <TextView android:id="@+id/healthSummary" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="Node.js: EMBEDDED 18.17.1 ✓\nGit: NOT REQUIRED — verified source updates\nRepository: MCP v2.4.7\nBridge: stopped" android:textColor="@color/muted" android:textSize="14sp" />
            <Button android:id="@+id/refreshButton" style="@style/ManagerButton.Secondary" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Refresh status" />
        </LinearLayout>

        <LinearLayout style="@style/Card" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
            <TextView style="@style/SectionTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Bridge connection" />
            <TextView style="@style/FieldLabel" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="BRIDGE PORT" />
            <EditText android:id="@+id/portField" style="@style/ManagerField" android:hint="16384" android:inputType="number" />
            <CheckBox android:id="@+id/lanModeCheckbox" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:buttonTint="@color/accent" android:paddingTop="6dp" android:paddingBottom="6dp"
                android:text="Allow trusted LAN relay for PC Codex / Claude" android:textColor="@color/text" android:textSize="14sp" />
            <TextView android:id="@+id/lanAddressText" style="@style/HintText" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="LAN access disabled. The executor still uses 127.0.0.1." />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                <Button android:id="@+id/startBridgeButton" style="@style/ManagerButton" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Start" />
                <Button android:id="@+id/stopBridgeButton" style="@style/ManagerButton.Danger" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Stop" />
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                <Button android:id="@+id/dashboardButton" style="@style/ManagerButton.Secondary" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Dashboard" />
                <Button android:id="@+id/copyLoaderButton" style="@style/ManagerButton.Secondary" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Copy executor code" />
            </LinearLayout>
            <Button android:id="@+id/copyPcRelayButton" style="@style/ManagerButton.Secondary" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Copy PC MCP relay arguments" />
        </LinearLayout>

        <LinearLayout style="@style/Card" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
            <TextView style="@style/SectionTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Background running" />
            <TextView style="@style/HintText" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="The bridge keeps running in a foreground service after this screen closes. Keep its notification enabled and allow unrestricted battery use. Stop, Force stop, or an OEM battery cleaner will disconnect Roblox and every MCP client." />
            <TextView android:id="@+id/backgroundStatus" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginBottom="8dp" android:text="BATTERY: CHECKING" android:textColor="@color/warning" android:textStyle="bold" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                <Button android:id="@+id/batteryOptimizationButton" style="@style/ManagerButton" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Allow unrestricted battery" />
                <Button android:id="@+id/appSettingsButton" style="@style/ManagerButton.Secondary" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="App settings" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout style="@style/Card" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
            <TextView style="@style/SectionTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="ChatGPT plugin connection" />
            <TextView style="@style/HintText" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="ChatGPT cannot reach phone localhost directly. This APK bundles the official OpenAI ARM64 tunnel-client and forwards it to the phone-local /mcp endpoint. Create a Platform runtime API key and tunnel, then keep both foreground services running." />
            <TextView style="@style/HintText" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="PLUGIN STEPS\n1. Create an API key and a tunnel; copy the tunnel_... ID.\n2. Start the local bridge and matching tunnel. Keep both running.\n3. Open ChatGPT Plugins and tap +.\n4. Choose Connection: Tunnel, select the same tunnel ID, and use No Auth.\n5. Review the custom-MCP warning, acknowledge it, and tap Create." />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                <Button android:id="@+id/openApiKeysButton" style="@style/ManagerButton.Secondary" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="API keys" />
                <Button android:id="@+id/openTunnelsButton" style="@style/ManagerButton.Secondary" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Tunnels" />
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                <Button android:id="@+id/openChatGptPluginsButton" style="@style/ManagerButton" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Open ChatGPT Plugins" />
                <Button android:id="@+id/copyChatGptChecklistButton" style="@style/ManagerButton.Secondary" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Copy setup steps" />
            </LinearLayout>
            <TextView style="@style/FieldLabel" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="PROFILE" />
            <EditText android:id="@+id/profileField" style="@style/ManagerField" android:hint="roblox-executor" android:inputType="text" />
            <TextView style="@style/FieldLabel" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="TUNNEL ID" />
            <EditText android:id="@+id/tunnelIdField" style="@style/ManagerField" android:hint="tunnel_..." android:inputType="text" />
            <TextView style="@style/FieldLabel" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="PLATFORM RUNTIME API KEY (MEMORY ONLY)" />
            <EditText android:id="@+id/runtimeKeyField" style="@style/ManagerField" android:hint="Paste key" android:inputType="textPassword" />
            <TextView android:id="@+id/tunnelStatus" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginBottom="8dp" android:text="TUNNEL-CLIENT: NOT STARTED" android:textColor="@color/warning" android:textStyle="bold" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                <Button android:id="@+id/configureTunnelButton" style="@style/ManagerButton.Secondary" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Configure" />
                <Button android:id="@+id/doctorTunnelButton" style="@style/ManagerButton.Secondary" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Doctor" />
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                <Button android:id="@+id/startTunnelButton" style="@style/ManagerButton" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Start tunnel" />
                <Button android:id="@+id/stopTunnelButton" style="@style/ManagerButton.Danger" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Stop" />
            </LinearLayout>
            <Button android:id="@+id/restartTunnelButton" style="@style/ManagerButton"
                android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Restart tunnel" />
            <Button android:id="@+id/tunnelDiagnosticsButton" style="@style/ManagerButton.Secondary"
                android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Open tunnel diagnostics" />
        </LinearLayout>

        <LinearLayout style="@style/Card" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
            <TextView style="@style/SectionTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="GPT files" />
            <TextView style="@style/HintText" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="Files imported from ChatGPT are kept in the app-private MCP cache. Download saves a copy through Android's document picker. Delete removes the cached copy from the bridge." />
            <TextView android:id="@+id/gptFilesSummary" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginBottom="8dp" android:text="No ChatGPT files are cached." android:textColor="@color/muted" android:textSize="13sp" />
            <LinearLayout android:id="@+id/gptFilesContainer" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                <Button android:id="@+id/refreshGptFilesButton" style="@style/ManagerButton.Secondary" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Refresh files" />
                <Button android:id="@+id/clearGptFilesButton" style="@style/ManagerButton.Danger" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Delete all" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout style="@style/Card" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
            <TextView style="@style/SectionTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Built-in console" />
            <TextView android:id="@+id/outputView" android:layout_width="match_parent" android:layout_height="220dp"
                android:background="@drawable/field_background" android:fontFamily="monospace" android:gravity="bottom" android:padding="12dp"
                android:fadeScrollbars="false" android:scrollbars="vertical" android:text="Manager ready." android:textColor="@color/text" android:textIsSelectable="true" android:textSize="11sp" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                <Button android:id="@+id/bridgeLogsButton" style="@style/ManagerButton.Secondary" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Refresh logs" />
                <Button android:id="@+id/managerUpdateButton" style="@style/ManagerButton.Secondary" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="App update" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
