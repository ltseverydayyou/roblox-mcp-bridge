<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:importantForAutofill="noExcludeDescendants">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingLeft="16dp"
        android:paddingTop="22dp"
        android:paddingRight="16dp"
        android:paddingBottom="32dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="ROBLOX MCP MANAGER"
            android:textColor="@color/accent"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Bridge control for Android"
            android:textColor="@color/text"
            android:textSize="27sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="18dp"
            android:text="Install, update, connect, and run the bridge without typing setup commands."
            android:textColor="@color/muted"
            android:textSize="14sp" />

        <LinearLayout
            style="@style/Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView style="@style/SectionTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="One-time Android runtime setup" />
            <TextView
                style="@style/HintText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Termux supplies Android-native Node.js and Git. Install the official app, run the copied permission command once, then connect this manager." />

            <TextView
                android:id="@+id/termuxStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="TERMUX: CHECKING"
                android:textColor="@color/warning"
                android:textStyle="bold" />

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                <Button android:id="@+id/openTermuxButton" style="@style/ManagerButton.Secondary" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Install / open" />
                <Button android:id="@+id/copyPermissionButton" style="@style/ManagerButton.Secondary" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Copy permission" />
            </LinearLayout>
            <Button android:id="@+id/connectTermuxButton" style="@style/ManagerButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Connect manager to Termux" />
        </LinearLayout>

        <LinearLayout
            style="@style/Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView style="@style/SectionTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="System health" />
            <TextView android:id="@+id/healthSummary" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Refresh status after connecting Termux." android:textColor="@color/muted" android:textSize="14sp" />
            <Button android:id="@+id/refreshButton" style="@style/ManagerButton.Secondary" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Refresh status" />
        </LinearLayout>

        <LinearLayout
            style="@style/Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView style="@style/SectionTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Bridge installation" />
            <TextView style="@style/FieldLabel" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="GITHUB REPOSITORY" />
            <EditText android:id="@+id/repositoryField" style="@style/ManagerField" android:hint="https://github.com/owner/repository.git" android:inputType="textUri" />
            <TextView style="@style/FieldLabel" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="BRANCH" />
            <EditText android:id="@+id/branchField" style="@style/ManagerField" android:hint="main" android:inputType="text" />
            <TextView style="@style/FieldLabel" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="LOCAL PORT" />
            <EditText android:id="@+id/portField" style="@style/ManagerField" android:hint="16384" android:inputType="number" />
            <Button android:id="@+id/installAllButton" style="@style/ManagerButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Install all required" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                <Button android:id="@+id/updateBridgeButton" style="@style/ManagerButton.Secondary" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Update" />
                <Button android:id="@+id/startBridgeButton" style="@style/ManagerButton" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Start" />
                <Button android:id="@+id/stopBridgeButton" style="@style/ManagerButton.Danger" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Stop" />
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                <Button android:id="@+id/dashboardButton" style="@style/ManagerButton.Secondary" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Dashboard" />
                <Button android:id="@+id/copyLoaderButton" style="@style/ManagerButton.Secondary" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Copy executor code" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            style="@style/Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView style="@style/SectionTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="ChatGPT tunnel" />
            <TextView style="@style/HintText" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="The runtime API key is passed to Termux through stdin and cleared from this screen after every operation." />
            <TextView style="@style/FieldLabel" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="PROFILE" />
            <EditText android:id="@+id/profileField" style="@style/ManagerField" android:hint="roblox-executor" android:inputType="text" />
            <TextView style="@style/FieldLabel" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="TUNNEL ID" />
            <EditText android:id="@+id/tunnelIdField" style="@style/ManagerField" android:hint="tunnel_..." android:inputType="text" />
            <TextView style="@style/FieldLabel" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="PLATFORM RUNTIME API KEY (MEMORY ONLY)" />
            <EditText android:id="@+id/runtimeKeyField" style="@style/ManagerField" android:hint="Paste key" android:inputType="textPassword" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                <Button android:id="@+id/installTunnelButton" style="@style/ManagerButton.Secondary" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Install client" />
                <Button android:id="@+id/configureTunnelButton" style="@style/ManagerButton.Secondary" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Configure" />
                <Button android:id="@+id/doctorTunnelButton" style="@style/ManagerButton.Secondary" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Doctor" />
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                <Button android:id="@+id/startTunnelButton" style="@style/ManagerButton" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Start tunnel" />
                <Button android:id="@+id/stopTunnelButton" style="@style/ManagerButton.Danger" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Stop tunnel" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            style="@style/Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView style="@style/SectionTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Live operation output" />
            <TextView
                android:id="@+id/outputView"
                android:layout_width="match_parent"
                android:layout_height="220dp"
                android:background="@drawable/field_background"
                android:fontFamily="monospace"
                android:gravity="bottom"
                android:padding="12dp"
                android:scrollbars="vertical"
                android:text="Manager ready."
                android:textColor="@color/text"
                android:textIsSelectable="true"
                android:textSize="11sp" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                <Button android:id="@+id/bridgeLogsButton" style="@style/ManagerButton.Secondary" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Bridge logs" />
                <Button android:id="@+id/tunnelLogsButton" style="@style/ManagerButton.Secondary" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Tunnel logs" />
                <Button android:id="@+id/managerUpdateButton" style="@style/ManagerButton.Secondary" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="App update" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
